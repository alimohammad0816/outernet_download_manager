{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Outernet",
  "version": "0.6.0",
  "identifier": "io.outernet.downloadmanager",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      { "title": "Outernet Download Manager", "width": 1060, "height": 660, "minWidth": 640, "minHeight": 490 }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "linux": { "deb": { "depends": ["ffmpeg"] } }
  }
}
