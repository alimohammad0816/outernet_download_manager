{
  "name": "outernet-download-manager",
  "version": "0.11.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "build": "tsc --noEmit && vite build",
    "tauri": "tauri",
    "check:extension": "node --check browser/background.js && node --check browser/popup.js && node --check browser/video.js && node --check browser/handoff.js && node --check browser/click-download.js && node --check browser/streams.js && node --check scripts/package-browser.mjs",
    "test:extension": "node --test --test-isolation=none scripts/browser-handoff.test.mjs scripts/browser-streams.test.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-dialog": "2.8.4",
    "lucide-react": "1.27.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.4",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "typescript": "5.9.3",
    "vite": "7.3.6"
  }
}
